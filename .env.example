# Claude API (optional for fetch/filter; required for AI drafting/classification)
ANTHROPIC_API_KEY=

# SMTP (required only for real email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here

# IMAP (required only for reading replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your_app_password_here

# Optional contact lookup
HUNTER_API_KEY=

# Optional Adzuna integration
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional public tracking URL; leave empty to disable open tracking
TRACKING_BASE_URL=
