# ============================================================
# Job Hunting Engine — configuration
# Copy to config.yaml and fill in your details.
# ============================================================

candidate:
  name: "Rodrigo Fernandes"
  email: "you@example.com"          # your sending address (must match SMTP_USER)
  location: "Dublin, Ireland"
  linkedin_url: "https://linkedin.com/in/yourprofile"
  portfolio_url: "https://github.com/rodrigofernandesireland-cloud"
  cv_path: "data/cv.pdf"            # optional attachment
  pitch: >
    Junior full-stack developer based in Dublin, comfortable with
    Python, JavaScript/TypeScript, and React. Recently completed
    [your bootcamp/degree/project]. Looking for a remote-friendly
    junior role at a European company where I can grow fast and
    ship real features from day one.

search:
  job_titles:
    - "junior developer"
    - "junior software engineer"
    - "graduate developer"
    - "entry level developer"
    - "junior full stack"
  exclude_keywords:
    - "senior"
    - "lead"
    - "staff"
    - "principal"
  remote_only: true
  # Countries/regions you're open to (used to filter listings when location data exists)
  target_regions:
    - "Ireland"
    - "United Kingdom"
    - "Germany"
    - "Netherlands"
    - "Spain"
    - "Portugal"
    - "France"
    - "Sweden"
    - "Remote Europe"
  sources:
    remoteok: true
    arbeitnow: true
    weworkremotely: true
    adzuna: false   # requires ADZUNA_APP_ID/KEY in .env

outreach:
  daily_send_limit: 25
  follow_up_after_days: 5
  max_follow_ups: 1
  send_window_hours: [9, 18]   # only send between 9am-6pm your local time
  subject_line: "Junior Developer — {candidate_name}, based in {candidate_location}"
  signoff: >
    Best,
    {candidate_name}
    {candidate_linkedin}

contact_finding:
  # Common email patterns to try, in order, when guessing an address.
  # {first}, {last}, {f}, {l}, {domain} are substituted.
  patterns:
    - "{first}.{last}@{domain}"
    - "{first}@{domain}"
    - "{f}{last}@{domain}"
    - "{first}{l}@{domain}"
    - "careers@{domain}"
    - "jobs@{domain}"
    - "hello@{domain}"
  # Roles to prefer when a job listing names a contact
  preferred_titles:
    - "engineering manager"
    - "talent acquisition"
    - "recruiter"
    - "hr"
    - "hiring manager"
    - "cto"
    - "founder"

claude:
  model: "claude-sonnet-4-6"
  personalization_temperature: 0.7